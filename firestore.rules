rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // 승인된 가족 = users 컬렉션에 본인 uid 문서가 있는 사용자
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isMember()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // 본인이 직접 바꿀 수 있는 필드(표시이름·알림 설정)만 허용
    function onlyProfileFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          "name", "notify_email", "notify_sources", "notify_push", "push_fids",
          "last_seen", "last_login"
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["name"])
            || (request.resource.data.name is string
                && request.resource.data.name.size() <= 80))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["notify_email"])
            || request.resource.data.notify_email is bool)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["notify_push"])
            || request.resource.data.notify_push is bool)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["notify_sources"])
            || request.resource.data.notify_sources is list)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["push_fids"])
            || validPushFids(request.resource.data.push_fids));
    }

    function validPushFids(fids) {
      return fids is list
        && fids.size() <= 5
        && (fids.size() < 1 || fids[0] is string)
        && (fids.size() < 2 || fids[1] is string)
        && (fids.size() < 3 || fids[2] is string)
        && (fids.size() < 4 || fids[3] is string)
        && (fids.size() < 5 || fids[4] is string);
    }

    function validAccessRequest(reqId) {
      return signedIn()
        && reqId == "req_" + request.auth.uid
        && request.resource.data.keys().hasOnly([
          "id", "email", "name", "provider", "uid", "requested_at", "status"
        ])
        && request.resource.data.id == reqId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.provider in ["password", "google", "firebase"]
        && request.resource.data.requested_at is string
        && request.resource.data.status == "pending";
    }

    // 로그인 게이트는 users/{본인 uid} 한 문서만 확인한다.
    // 전체 가족 목록(이메일·알림 설정 포함)은 관리자만 조회할 수 있다.
    match /users/{userId} {
      allow get: if ownsUser(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (ownsUser(userId) && onlyProfileFields());
    }

    // 모니터링 콘텐츠: 승인된 가족은 누구나 추가/수정/삭제 (메인 PC 불필요)
    match /groups/{groupId} {
      allow read, create, update, delete: if isMember();
    }
    match /sources/{sourceId} {
      allow read, create, update, delete: if isMember();
    }
    match /items/{itemId} {
      allow read: if isMember();
      allow delete: if isMember();                 // 휴지통 완전삭제
      allow create: if isAdmin();                  // 신규 수집은 크롤러(Admin SDK)
      allow update: if isMember()                  // 읽음/삭제/보관 상태 전환
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "read_at", "deleted_at", "auto_archived_at"])
        && request.resource.data.status in ["new", "read", "archived_unread", "deleted"];
    }

    match /crawl_logs/{logId} {
      allow read: if isMember();
      allow create, update, delete: if isAdmin();  // 크롤러 Admin SDK
    }

    // 앱 설정(자동 보관일수·이메일) — 관리자만
    match /app_config/{doc} {
      allow read: if isMember();
      allow create, update, delete: if isAdmin();
    }

    // 가입 신청: 본인 이메일로만 신청/조회, 승인·거절은 관리자
    // 문서 ID는 신청자 uid(req_<uid>)라 재로그인해도 신청이 중복되지 않는다.
    match /access_requests/{reqId} {
      allow create: if validAccessRequest(reqId);
      allow read: if isAdmin()
        || (signedIn()
            && reqId == "req_" + request.auth.uid
            && resource.data.uid == request.auth.uid
            && resource.data.email == request.auth.token.email);
      allow update: if isAdmin()
        || (validAccessRequest(reqId)
            && resource.data.uid == request.auth.uid
            && resource.data.email == request.auth.token.email
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(["name", "provider", "requested_at"]));
      allow delete: if isAdmin();
    }

    // 로그인 사이트 자격증명: 관리자만 '쓰기'(이미 암호화된 값 저장). '읽기'는 차단(복호화는 크롤러 Admin SDK 전용).
    match /credentials/{credentialId} {
      allow read: if false;
      allow create, update, delete: if isAdmin();
    }

    // 이메일 재시도 대기열은 크롤러(Admin SDK)만 접근한다.
    match /notification_jobs/{jobId} {
      allow read, write: if false;
    }
  }
}
