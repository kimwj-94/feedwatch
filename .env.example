# FeedWatch local settings
FEEDWATCH_STORAGE=local
FEEDWATCH_LOCAL_STORE=data/local_store.json
FEEDWATCH_ADMIN_EMAIL=admin@example.com

# Firebase / Google services
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
YOUTUBE_API_KEY=

# Security — 로그인 사이트 자격증명·네이버 쿠키 복호화용. 웹 관리자가 정한 '수집 비밀번호'와 동일하게 설정.
FEEDWATCH_CRED_PASSPHRASE=

# Email. If SMTP is not configured, FeedWatch writes data/last_email_preview.html instead.
EMAIL_PROVIDER=preview
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
GMAIL_CLIENT_SECRET_FILE=client_secret.json
GMAIL_TOKEN_FILE=token.json
GOOGLE_OAUTH_CLIENT_SECRET_FILE=client_secret.json
GOOGLE_OAUTH_TOKEN_FILE=google_login_token.json

# Crawling
CRAWL_MIN_DELAY_SECONDS=3
CRAWL_MAX_DELAY_SECONDS=5
PLAYWRIGHT_HEADLESS=true
